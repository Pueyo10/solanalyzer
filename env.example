# ===========================================
# SolAnalyzer Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp env.example .env

# ----- Flask Configuration -----
SECRET_KEY=your-super-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=1

# ----- Database -----
SQLALCHEMY_DATABASE_URI=sqlite:///data/db/solanalyzer.db

# ----- Celery Configuration -----
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://:your-redis-password@localhost:6379/0

# ----- Redis Configuration -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ----- Solana RPC Endpoints -----
# You can get free endpoints from QuickNode, Alchemy, or Helius
SOLANA_CLIENT_URL=https://api.mainnet-beta.solana.com
ENDPOINT_1=https://your-endpoint-1.solana-mainnet.quiknode.pro/your-api-key/
ENDPOINT_2=https://your-endpoint-2.solana-mainnet.quiknode.pro/your-api-key/
ENDPOINT_3=https://your-endpoint-3.solana-mainnet.quiknode.pro/your-api-key/
ENDPOINT_4=https://your-endpoint-4.solana-mainnet.quiknode.pro/your-api-key/
ENDPOINT_5=https://your-endpoint-5.solana-mainnet.quiknode.pro/your-api-key/
ENDPOINT_6=https://your-endpoint-6.solana-mainnet.quiknode.pro/your-api-key/
ENDPOINT_7=https://your-endpoint-7.solana-mainnet.quiknode.pro/your-api-key/
ENDPOINT_8=https://your-endpoint-8.solana-mainnet.quiknode.pro/your-api-key/
ENDPOINT_9=https://your-endpoint-9.solana-mainnet.quiknode.pro/your-api-key/
ENDPOINT_10=https://your-endpoint-10.solana-mainnet.quiknode.pro/your-api-key/

# ----- Moralis API Keys -----
# Get your API key from https://moralis.io/
MORALIS_API_KEY_1=your-moralis-api-key-1
MORALIS_API_KEY_2=your-moralis-api-key-2

# ----- Email Configuration (Flask-Mail) -----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ----- Admin Configuration -----
ADMIN_USERNAME=admin
# Generate hash with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:your-hashed-password

# ----- Subscription Wallet -----
# Wallet address to receive subscription payments
SUBSCRIPTION_WALLET=your-solana-wallet-address

